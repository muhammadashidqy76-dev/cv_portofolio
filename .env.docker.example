# ==============================================================================
# Laravel Environment Template for Docker Deployment
# Copy this file to .env before running: docker compose up -d
# ==============================================================================

APP_NAME="Ashidqy Portfolio"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=http://localhost

LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=error

# ─── Docker Database Configuration (Matches docker-compose.yml) ───────────────
# When running inside Docker, DB_HOST must be the service name: "db"
DB_CONNECTION=mysql
DB_HOST=db
DB_PORT=3306
DB_DATABASE=cv_portofolio
DB_USERNAME=cv_user
DB_PASSWORD=GantiPasswordKuatAnda123!
DB_ROOT_PASSWORD=GantiRootPasswordKuatAnda123!

# ─── Cache, Queue, and Session Drivers (Using Redis Container) ─────────────────
# When running inside Docker, REDIS_HOST must be the service name: "redis"
BROADCAST_DRIVER=log
CACHE_DRIVER=redis
FILESYSTEM_DISK=public
QUEUE_CONNECTION=redis
SESSION_DRIVER=redis
SESSION_LIFETIME=120

REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379

MEMCACHED_HOST=127.0.0.1

MAIL_MAILER=smtp
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="hello@ashidqy.dev"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

